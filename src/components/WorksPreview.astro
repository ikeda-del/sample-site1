---
import { works } from '../data/works';

const previewWorks = works.slice(0, 3);
---

<section id="works" class="border-t border-slate-200 bg-accent py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 flex flex-col gap-4 border-b-2 border-primary pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold tracking-widest text-primary">WORKS</p>
        <h2 class="mt-1 text-2xl font-bold text-slate-900 sm:text-3xl">施工事例</h2>
      </div>
      <a
        href="/works"
        class="inline-flex items-center gap-1 text-sm font-semibold text-primary transition hover:text-primary-dark"
      >
        すべて見る
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        previewWorks.map((work) => (
          <li>
            <a
              href="/works"
              class="group flex flex-col overflow-hidden rounded-sm border border-slate-200 bg-white shadow-sm transition hover:border-primary/30 hover:shadow-md"
            >
              <div class="aspect-16/10 overflow-hidden">
                <img
                  src={work.image}
                  alt={work.imageAlt}
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  loading="lazy"
                  width="800"
                  height="500"
                />
              </div>
              <div class="p-5">
                <span class="rounded-sm bg-accent px-2.5 py-0.5 text-xs font-semibold text-primary">
                  {work.category}
                </span>
                <h3 class="mt-3 text-base font-bold text-slate-900 group-hover:text-primary">
                  {work.title}
                </h3>
                <p class="mt-2 text-sm text-slate-600 line-clamp-2">{work.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
