---
interface Props {
  titleEn: string;
  titleJa: string;
  description?: string;
}

const { titleEn, titleJa, description } = Astro.props;
---

<section class="relative overflow-hidden bg-primary pt-16 sm:pt-20">
  <div
    class="absolute inset-0 bg-linear-to-br from-primary-dark via-primary to-primary-light opacity-90"
    aria-hidden="true"
  ></div>
  <div class="relative mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <nav class="mb-6 text-sm text-blue-100" aria-label="パンくずリスト">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="transition hover:text-white">ホーム</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-white" aria-current="page">{titleJa}</li>
      </ol>
    </nav>
    <p class="text-sm font-semibold tracking-widest text-blue-100">{titleEn}</p>
    <h1 class="mt-1 text-3xl font-bold text-white sm:text-4xl">{titleJa}</h1>
    {description && <p class="mt-4 max-w-2xl text-sm leading-relaxed text-blue-50 sm:text-base">{description}</p>}
  </div>
</section>
