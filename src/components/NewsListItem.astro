---
import type { NewsItem } from '../data/news';

interface Props {
  item: NewsItem;
}

const { item } = Astro.props;
const href = `/news/${item.slug}`;
---

<li data-category={item.category} class="news-item">
  <a
    href={href}
    class="group flex flex-col gap-3 py-5 transition sm:flex-row sm:items-center sm:gap-6 sm:py-6"
  >
    <time datetime={item.dateIso} class="shrink-0 text-sm tabular-nums text-slate-500">
      {item.date}
    </time>
    <span class="inline-flex w-fit shrink-0 rounded-sm bg-accent px-2.5 py-0.5 text-xs font-semibold text-primary">
      {item.category}
    </span>
    <span class="flex-1 text-sm font-medium text-slate-800 transition group-hover:text-primary sm:text-base">
      {item.title}
    </span>
    <span class="hidden shrink-0 text-primary opacity-0 transition group-hover:opacity-100 sm:block">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
      </svg>
    </span>
  </a>
</li>
