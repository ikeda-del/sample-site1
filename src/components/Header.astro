---
import { navItems, isNavActive } from '../config/navigation';

const pathname = Astro.url.pathname;
---

<header
  class="fixed top-0 right-0 left-0 z-50 border-b border-slate-200/80 bg-white/95 shadow-sm backdrop-blur-sm"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:h-20 sm:px-6 lg:px-8">
    <a href="/" class="group flex items-center gap-3">
      <span
        class="flex h-10 w-10 items-center justify-center rounded-sm bg-primary text-sm font-bold text-white transition-colors group-hover:bg-primary-dark sm:h-11 sm:w-11"
        aria-hidden="true"
      >
        建
      </span>
      <div class="leading-tight">
        <p class="text-[10px] tracking-wider text-slate-500 sm:text-xs">株式会社</p>
        <p class="text-sm font-bold text-primary sm:text-base">サンプル建設</p>
      </div>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="メインナビゲーション">
      {
        navItems.map((item) => {
          const active = isNavActive(item.href, pathname);
          return (
            <a
              href={item.href}
              class:list={[
                "rounded px-3 py-2 text-sm font-medium transition-colors",
                active
                  ? "bg-accent font-semibold text-primary"
                  : "text-slate-600 hover:bg-accent hover:text-primary",
              ]}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <button
      type="button"
      id="mobile-menu-btn"
      class="inline-flex h-10 w-10 items-center justify-center rounded text-primary lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="メニューを開く"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-slate-200 bg-white px-4 py-4 lg:hidden"
    aria-label="モバイルナビゲーション"
  >
    <ul class="space-y-1">
      {
        navItems.map((item) => {
          const active = isNavActive(item.href, pathname);
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "mobile-nav-link block rounded px-3 py-2.5 text-sm font-medium transition",
                  active
                    ? "bg-accent font-semibold text-primary"
                    : "text-slate-700 hover:bg-accent hover:text-primary",
                ]}
                aria-current={active ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const links = document.querySelectorAll(".mobile-nav-link");

  btn?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(isOpen));
    btn.setAttribute("aria-label", isOpen ? "メニューを閉じる" : "メニューを開く");
  });

  links.forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      btn?.setAttribute("aria-expanded", "false");
      btn?.setAttribute("aria-label", "メニューを開く");
    });
  });
</script>
