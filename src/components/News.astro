---
interface NewsItem {
  date: string;
  category: string;
  title: string;
  href: string;
}

const newsItems: NewsItem[] = [
  {
    date: "2026.05.28",
    category: "お知らせ",
    title: "ホームページをリニューアルしました",
    href: "#",
  },
  {
    date: "2026.04.15",
    category: "採用",
    title: "2027年度新卒・キャリア採用のエントリー受付を開始しました",
    href: "#",
  },
  {
    date: "2026.03.10",
    category: "施工事例",
    title: "市道舗装工事が完了しました",
    href: "#",
  },
  {
    date: "2026.02.01",
    category: "お知らせ",
    title: "安全大会を開催し、全社員で安全意識の向上に努めました",
    href: "#",
  },
];
---

<section id="news" class="bg-white py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 flex flex-col gap-4 border-b-2 border-primary pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold tracking-widest text-primary">NEWS</p>
        <h2 class="mt-1 text-2xl font-bold text-slate-900 sm:text-3xl">お知らせ</h2>
      </div>
      <a
        href="#"
        class="inline-flex items-center gap-1 text-sm font-semibold text-primary transition hover:text-primary-dark"
      >
        一覧を見る
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <ul class="divide-y divide-slate-200">
      {
        newsItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="group flex flex-col gap-3 py-5 transition sm:flex-row sm:items-center sm:gap-6 sm:py-6"
            >
              <time
                datetime={item.date.replace(/\./g, "-")}
                class="shrink-0 text-sm tabular-nums text-slate-500"
              >
                {item.date}
              </time>
              <span class="inline-flex w-fit shrink-0 rounded-sm bg-accent px-2.5 py-0.5 text-xs font-semibold text-primary">
                {item.category}
              </span>
              <span class="flex-1 text-sm font-medium text-slate-800 transition group-hover:text-primary sm:text-base">
                {item.title}
              </span>
              <span class="hidden shrink-0 text-primary opacity-0 transition group-hover:opacity-100 sm:block">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
