---
import NewsList from './NewsList.astro';
---

<section id="news" class="bg-white py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 flex flex-col gap-4 border-b-2 border-primary pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold tracking-widest text-primary">NEWS</p>
        <h2 class="mt-1 text-2xl font-bold text-slate-900 sm:text-3xl">お知らせ</h2>
      </div>
      <a
        href="/news"
        class="inline-flex items-center gap-1 text-sm font-semibold text-primary transition hover:text-primary-dark"
      >
        一覧を見る
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <NewsList limit={4} />
  </div>
</section>
