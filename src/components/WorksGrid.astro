---
import { works, workCategories } from '../data/works';
import WorkCard from './WorkCard.astro';
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <p class="max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
        公共工事から民間工事まで、当社が手がけた代表的な施工事例をご紹介します。地域のインフラ整備や施設の新築・改修など、幅広い実績があります。
      </p>
      <div class="flex flex-wrap gap-2" role="group" aria-label="カテゴリで絞り込み">
        {
          workCategories.map((category, index) => (
            <button
              type="button"
              data-category={category}
              class:list={[
                "filter-btn rounded-sm px-3 py-1.5 text-xs font-semibold transition sm:text-sm",
                index === 0
                  ? "bg-primary text-white"
                  : "border border-slate-200 bg-white text-slate-600 hover:border-primary hover:text-primary",
              ]}
            >
              {category}
            </button>
          ))
        }
      </div>
    </div>

    <ul id="works-grid" class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        works.map((work) => (
          <li data-category={work.category} class="works-item">
            <WorkCard work={work} />
          </li>
        ))
      }
    </ul>

    <p id="works-empty" class="hidden py-16 text-center text-sm text-slate-500">
      該当する施工事例はありません。
    </p>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const items = document.querySelectorAll<HTMLElement>(".works-item");
  const empty = document.getElementById("works-empty");

  const activeClasses = ["bg-primary", "text-white"];
  const inactiveClasses = ["border", "border-slate-200", "bg-white", "text-slate-600"];

  function setButtonStyle(btn: HTMLButtonElement, active: boolean) {
    if (active) {
      btn.classList.add(...activeClasses);
      btn.classList.remove(...inactiveClasses, "hover:border-primary", "hover:text-primary");
    } else {
      btn.classList.remove(...activeClasses);
      btn.classList.add(...inactiveClasses, "hover:border-primary", "hover:text-primary");
    }
  }

  function applyFilter(category: string) {
    let visible = 0;
    items.forEach((item) => {
      const match = category === "すべて" || item.dataset.category === category;
      item.classList.toggle("hidden", !match);
      if (match) visible++;
    });
    empty?.classList.toggle("hidden", visible > 0);
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const category = btn.dataset.category ?? "すべて";
      buttons.forEach((b) => setButtonStyle(b, b === btn));
      applyFilter(category);
    });
  });
</script>
