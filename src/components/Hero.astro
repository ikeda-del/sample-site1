---
const catchCopy = "地域社会と共に";
const subCopy =
  "創業以来、地域のインフラ整備と暮らしの基盤づくりに貢献してまいりました。誠意と技術で、皆様のご期待にお応えします。";
---

<section
  id="top"
  class="relative flex min-h-screen items-center justify-center overflow-hidden pt-16 sm:pt-20"
>
  <div class="absolute inset-0">
    <img
      src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=1920&q=80"
      alt=""
      class="h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-linear-to-br from-primary-dark/85 via-primary/75 to-primary-light/60"
      aria-hidden="true"
    ></div>
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 py-24 text-center text-white sm:px-6 lg:px-8">
    <p class="mb-4 text-sm font-medium tracking-[0.3em] text-blue-100 sm:text-base">
      SAMPLE CONSTRUCTION CO., LTD.
    </p>
    <h1 class="text-4xl leading-tight font-bold tracking-wide sm:text-5xl md:text-6xl lg:text-7xl">
      {catchCopy}
    </h1>
    <p class="mx-auto mt-8 max-w-2xl text-base leading-relaxed text-blue-50/95 sm:text-lg">
      {subCopy}
    </p>
    <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="#about"
        class="inline-flex min-w-[200px] items-center justify-center rounded-sm bg-white px-8 py-3.5 text-sm font-bold text-primary shadow-lg transition hover:bg-blue-50"
      >
        会社概要を見る
      </a>
      <a
        href="#contact"
        class="inline-flex min-w-[200px] items-center justify-center rounded-sm border-2 border-white/90 px-8 py-3.5 text-sm font-bold text-white transition hover:bg-white/10"
      >
        お問い合わせ
      </a>
    </div>
  </div>

  <a
    href="#news"
    class="absolute bottom-8 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-2 text-white/80 transition hover:text-white"
    aria-label="お知らせへスクロール"
  >
    <span class="text-[10px] tracking-widest">SCROLL</span>
    <svg class="h-5 w-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
    </svg>
  </a>
</section>
