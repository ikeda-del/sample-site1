---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PageHeader from '../../components/PageHeader.astro';
import WorksGrid from '../../components/WorksGrid.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="施工事例｜株式会社サンプル建設"
  description="株式会社サンプル建設の施工事例一覧。土木・建築・舗装など、地域のインフラ整備と施設工事の実績をご紹介します。"
>
  <Header />
  <main>
    <PageHeader
      titleEn="WORKS"
      titleJa="施工事例"
      description="地域社会の発展に貢献してきた、当社の施工実績をご覧ください。"
    />
    <WorksGrid />
    <section class="border-t border-slate-200 bg-accent py-12 sm:py-16">
      <div class="mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
        <p class="text-sm text-slate-600">
          工事のご相談・お見積りはお気軽にお問い合わせください。
        </p>
        <a
          href="/#contact"
          class="mt-6 inline-flex items-center gap-2 rounded-sm bg-primary px-8 py-3.5 text-sm font-bold text-white shadow-md transition hover:bg-primary-dark"
        >
          お問い合わせはこちら
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
